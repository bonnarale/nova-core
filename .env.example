PROJECT_NAME=NOVA CORE
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://webui.localhost,http://localhost:8080

TRAEFIK_DASHBOARD_HOST=traefik.localhost
BACKEND_HOST=api.localhost
OPEN_WEBUI_HOST=webui.localhost
N8N_HOST=n8n.localhost

POSTGRES_DB=nova_core
POSTGRES_USER=nova_core
POSTGRES_PASSWORD=nova-core-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=nova-core-redis-password

CHROMA_HOST=chroma
CHROMA_PORT=8000

OLLAMA_HOST=ollama
OLLAMA_PORT=11434

OPEN_WEBUI_SECRET_KEY=nova-core-open-webui-secret-key
OPEN_WEBUI_DEFAULT_MODELS=llama3.2

N8N_ENCRYPTION_KEY=nova-core-n8n-encryption-key-32
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=nova-core-n8n-admin-password
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=nova-core-n8n-postgres-password
