          ]
        ]
      },
      "Prepare Body Phase 1": {
        "main": [
          [
            {
              "node": "Phase 1: Deep Research Architect",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Phase 1: Deep Research Architect": {
        "main": [
          [
            {
              "node": "Extract Execution Prompt",
