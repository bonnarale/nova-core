[
  {
    "name": "Deep Research Pipeline",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "deep-research",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "webhook-trigger",
        "name": "Webhook Trigger",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          250,
          300
        ],
        "webhookId": "deep-research"
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body;\nconst topic = body.topic || '';\nconst mode = body.mode || 'assisted';\nconst audit = body.audit !== false;\n\nif (!topic) {\n  throw new Error('Missing required field: topic');\n}\n\nreturn [{ json: { topic, mode, audit, timestamp: new Date().toISOString() } }];"
        },
        "id": "validate-input",
        "name": "Validate Input",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          470,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "// Prepare the dispatch request body as a proper object\nconst topic = $json.topic;\nconst mode = $json.mode;\n\nconst requestBody = {\n  task: `Design a deep research execution prompt for: ${topic}. Mode: ${mode}. Produce a self-contained prompt that an external research tool can execute.`,\n  context: {\n    agent_id: 'prompter',\n    prompt: `You are a Deep Research Architect. Design a comprehensive research execution prompt for the topic: ${topic}. Include: research questions, search strategy, expected sources, quality criteria. Mode: ${mode}.`,\n    level: 3,\n    domain: 'research'\n  }\n};\n\nreturn [{ json: requestBody }];"
        },
        "id": "prepare-body-phase1",
        "name": "Prepare Body Phase 1",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          580,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://nova-core-backend-1:8000/api/v1/agents/runtime/dispatch",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json) }}",
          "options": {
            "timeout": 60000
          }
        },
        "id": "phase1-deepr",
        "name": "Phase 1: Deep Research Architect",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          790,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "const result = $input.first().json;\nconst agentResult = result.result || result;\nconst improvedPrompt = agentResult.improved_prompt || agentResult.prompt || '';\n\nreturn [{\n  json: {\n    topic: $('Validate Input').first().json.topic,\n    execution_prompt: improvedPrompt,\n    changes: agentResult.changes_made || [],\n    level: agentResult.level_applied || 0\n  }\n}];"
        },
        "id": "extract-prompt",
        "name": "Extract Execution Prompt",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1010,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "// Prepare RAG query body\nconst executionPrompt = $json.execution_prompt;\n\nreturn [{\n  json: {\n    query: executionPrompt,\n    top_k: 10\n  }\n}];"
        },
        "id": "prepare-body-phase2",
        "name": "Prepare Body Phase 2",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1230,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://nova-core-backend-1:8000/api/v1/rag/query",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json) }}",
          "options": {
            "timeout": 30000
          }
        },
        "id": "phase2-retrieval",
        "name": "Phase 2: Knowledge Retrieval",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1450,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "const retrieval = $input.first().json;\nconst context = retrieval.context || {};\nconst chunks = context.retrieved_chunks || [];\n\nconst researchContext = chunks.map(c => {\n  const content = c.chunk?.content || '';\n  const score = c.score || 0;\n  const title = c.chunk?.metadata?.title || 'unknown';\n  return `[${title}] (score: ${score.toFixed(3)}) ${content.substring(0, 200)}`;\n}).join('\\n---\\n');\n\nreturn [{\n  json: {\n    topic: $('Extract Execution Prompt').first().json.topic,\n    execution_prompt: $('Extract Execution Prompt').first().json.execution_prompt,\n    research_context: researchContext,\n    chunks_found: chunks.length\n  }\n}];"
        },
        "id": "build-context",
        "name": "Build Research Context",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1670,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "audit-check",
                "leftValue": "={{ $('Validate Input').first().json.audit }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals",
                  "singleValue": false
                }
              }
            ],
            "combinator": "and"
          }
        },
        "id": "audit-gate",
        "name": "Audit Enabled?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          1890,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "// Prepare audit dispatch body\nconst topic = $('Validate Input').first().json.topic;\nconst chunksFound = $json.chunks_found;\n\nreturn [{\n  json: {\n    task: `Audit the research output for topic: ${topic}. Evaluate across 10 dimensions: source integrity, perspective diversity, evidence quality, bias detection, confidence calibration, information gaps, internal consistency, relevance, structure, actionability.`,\n    context: {\n      agent_id: 'critic-premortem',\n      plan: `Research on ${topic}. Retrieved ${chunksFound} knowledge chunks.`,\n      level: 2\n    }\n  }\n}];"
        },
        "id": "prepare-body-phase3",
        "name": "Prepare Body Phase 3",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2110,
          200
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://nova-core-backend-1:8000/api/v1/agents/runtime/dispatch",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json) }}",
          "options": {
            "timeout": 60000
          }
        },
        "id": "phase3-audit",
        "name": "Phase 3: Research Audit",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          2330,
          200
        ]
      },
      {
        "parameters": {
          "jsCode": "const audit = $input.first().json;\nconst auditResult = audit.result || audit;\n\nreturn [{\n  json: {\n    topic: $('Validate Input').first().json.topic,\n    execution_prompt: $('Extract Execution Prompt').first().json.execution_prompt,\n    research_context: $('Build Research Context').first().json.research_context,\n    audit_summary: auditResult.summary || 'No audit summary',\n    failure_reasons: auditResult.failure_reasons || [],\n    checklist: auditResult.checklist || []\n  }\n}];"
        },
        "id": "merge-audit",
        "name": "Merge Audit Results",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2550,
          200
        ]
      },
      {
        "parameters": {
          "jsCode": "const data = $input.first().json;\n\nconst output = {\n  status: 'completed',\n  topic: data.topic,\n  execution_prompt: data.execution_prompt,\n  research_context: data.research_context || '',\n  audit: {\n    summary: data.audit_summary || 'Audit skipped',\n    failure_reasons: data.failure_reasons || [],\n    checklist: data.checklist || []\n  },\n  timestamp: new Date().toISOString()\n};\n\nreturn [{ json: output }];"
        },
        "id": "format-output",
        "name": "Format Final Output",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2770,
          300
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $json }}",
          "options": {
            "responseCode": 200
          }
        },
        "id": "respond-webhook",
        "name": "Respond to Webhook",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          2990,
          300
        ]
      }
    ],
    "connections": {
      "Webhook Trigger": {
        "main": [
          [
            {
              "node": "Validate Input",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Validate Input": {
        "main": [
          [
            {
              "node": "Prepare Body Phase 1",
              "type": "main",
              "index": 0
