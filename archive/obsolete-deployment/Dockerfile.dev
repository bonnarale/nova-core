# Multi-stage build for NOVA CORE — Development
FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=development \
    DEBUG=true \
    LOG_LEVEL=debug

WORKDIR /app

RUN pip install --upgrade pip setuptools wheel

COPY backend/pyproject.toml backend/README.md /app/
COPY backend/app /app/app

RUN pip install --no-cache-dir ".[dev]" 2>/dev/null || pip install --no-cache-dir fastapi uvicorn pydantic sqlalchemy aiosqlite httpx redis pytest pytest-asyncio

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
